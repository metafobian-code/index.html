<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><title>Hielo en llamas</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html,body{height:100%;margin:0;background:#000}body{display:flex;align-items:center;justify-content:center}
canvas{max-width:100%;max-height:100%;display:block}</style></head><body>
<canvas id="c" width="1333" height="800"></canvas>
<script>
const W=1333,H=800,WL=418;
const img=new Image();
img.onload=()=>{
const c=document.getElementById('c'),x=c.getContext('2d');
const o=document.createElement('canvas');o.width=W;o.height=H;const g=o.getContext('2d');
const bases=[[330,50],[425,60],[545,85],[637,25],[785,75],[965,90]];
const F=document.createElement('canvas');F.width=333;F.height=100;const f=F.getContext('2d');
const em=[];
function fire(t){
 f.clearRect(0,0,333,100);const BL=40,ramp=Math.min(1,t/2.5);
 for(let i=0;i<333;i++){const X=i*4;let near=0;
  for(const [cx,hw] of bases)near=Math.max(near,Math.max(0,1-Math.abs(X-cx)/(hw+40)));
  const w=Math.sin(i*0.09+t*2.1)*0.5+Math.sin(i*0.23-t*3.7)*0.3+Math.sin(i*0.61+t*7.3)*0.2;
  const h=((10+near*18)*(0.75+0.45*w)+Math.random()*3)*ramp;if(h<1)continue;
  f.fillStyle='rgba(255,20,0,0.75)';f.fillRect(i,BL-h,1,h*0.35);
  f.fillStyle='rgba(255,120,0,0.9)';f.fillRect(i,BL-h*0.7,1,h*0.4);
  f.fillStyle='rgba(255,240,150,0.95)';f.fillRect(i,BL-h*0.35,1,h*0.35);
  const sh=Math.round(Math.sin(i*0.3+t*3)*1.5);
  f.fillStyle='rgba(255,240,150,0.35)';f.fillRect(i+sh,BL,1,h*0.3);
  f.fillStyle='rgba(255,110,0,0.25)';f.fillRect(i+sh,BL+h*0.3,1,h*0.3);
  f.fillStyle='rgba(255,20,0,0.15)';f.fillRect(i+sh,BL+h*0.6,1,h*0.25);
 }
}
function frame(ms){
 const t=ms/1000;
 // pasada 1: ondas horizontales en las líneas de agua
 g.fillStyle='#000';g.fillRect(0,0,W,H);
 g.drawImage(img,0,0,W,330,0,0,W,330);
 for(let y=330;y<H;y+=2){
  const r=Math.min(1,(y-330)/60)*Math.max(0,1-(y-600)/200);
  const dx=Math.sin(y*0.045+t*1.6)*9*r+Math.sin(y*0.02-t*0.9)*5*r;
  g.drawImage(img,0,y,W,2,dx,y,W,2);
 }
 // pasada 2: reflejos y edificios con vaivén de ola que viaja
 x.fillStyle='#000';x.fillRect(0,0,W,H);
 for(let px=0;px<W;px+=2){
  const b=Math.sin(px*0.011-t*1.3)*7+Math.sin(px*0.023-t*0.8)*3;
  x.drawImage(o,px,WL,2,H-WL,px,WL-b*0.9,2,H-WL);
 }
 for(let px=0;px<W;px+=2){
  const b=Math.sin(px*0.011-t*1.3)*7+Math.sin(px*0.023-t*0.8)*3;
  x.drawImage(o,px,0,2,WL,px,b,2,WL);
 }
 // ondas que se forman alrededor de cada base
 x.lineWidth=1.5;
 bases.forEach(([cx,hw],i)=>{
  for(let k=0;k<3;k++){
   const p=((t*0.35+k/3+i*0.17)%1);
   const rx=hw*0.6+p*hw*2.2, ry=rx*0.10;
   x.strokeStyle='rgba(220,235,245,'+(0.55*(1-p)).toFixed(3)+')';
   x.beginPath();x.ellipse(cx,WL+4+Math.sin(cx*0.011-t*1.3)*3,rx,ry,0,0,Math.PI*2);x.stroke();
  }
 });
 fire(t);
 x.save();x.globalCompositeOperation='lighter';x.imageSmoothingEnabled=true;
 x.filter='blur(4px)';x.drawImage(F,0,0,333,100,0,270,1333,400);
 x.filter='none';x.globalAlpha=0.85;x.drawImage(F,0,0,333,100,0,270,1333,400);x.globalAlpha=1;
 const ramp=Math.min(1,t/2.5),fl=0.22+0.06*Math.sin(t*9)+0.03*Math.sin(t*23);
 const gr=x.createLinearGradient(0,120,0,440);gr.addColorStop(0,'rgba(255,60,0,0)');gr.addColorStop(1,`rgba(255,90,0,${fl*ramp})`);
 x.fillStyle=gr;x.fillRect(150,100,1000,340);
 x.fillStyle=`rgba(255,60,0,${0.07*ramp})`;x.fillRect(0,430,W,370);
 for(let k=0;k<3;k++)em.push({x:250+Math.random()*850,y:430-Math.random()*20,vx:(Math.random()-.5)*1.2,vy:-(1.5+Math.random()*3),l:1,r:1+Math.random()*2});
 for(let i=em.length-1;i>=0;i--){const e=em[i];e.x+=e.vx+Math.sin(t*3+i)*0.4;e.y+=e.vy;e.l-=0.014;if(e.l<=0){em.splice(i,1);continue}
  x.fillStyle=`rgba(255,${120+e.l*110|0},20,${e.l})`;x.beginPath();x.arc(e.x,e.y,e.r,0,6.283);x.fill()}
 x.restore();
 requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
};
img.src="hielo.jpg";
</script></body></html>
